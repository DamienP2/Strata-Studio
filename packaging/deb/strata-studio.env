# Réglages de Strata Studio. Après une modification :
#   sudo systemctl restart strata-studio
# Toutes les options : strata-studio --help

# L'adresse et le port de l'API.
STRATA_STUDIO_LISTEN=0.0.0.0:8095

# Où le serveur enregistre les tournages.
STRATA_STUDIO_REC_DIR=/var/lib/strata-studio/enregistrements

# Les appareils du studio, sur une seule ligne. Vide : un studio simulé.
# Exemple :
# STRATA_STUDIO_ARGS=--atem 192.168.10.2 --console m32:192.168.10.4 --buttons 192.168.10.5:8000 --aes67 /etc/strata-studio/console.sdp --aes67-if 192.168.20.10 --whisper 127.0.0.1:8178
STRATA_STUDIO_ARGS=
