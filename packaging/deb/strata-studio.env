# Réglages de Strata Studio. Après une modification :
#   sudo systemctl restart strata-studio
# Toutes les options : strata-studio --help

# L'adresse et le port des pages et de l'API.
STRATA_STUDIO_LISTEN=0.0.0.0:8095

# Le dossier de Studio : les réglages (reglages.json, modifiés depuis
# l'administration ou par l'installateur) et l'historique des tournages.
STRATA_STUDIO_DATA=/var/lib/strata-studio

# Où le serveur enregistre les tournages.
STRATA_STUDIO_REC_DIR=/var/lib/strata-studio/enregistrements

# Les appareils se règlent dans l'administration (page Système) ou avec
# l'installateur. Des options ici passent avant les réglages, par exemple :
# STRATA_STUDIO_ARGS=--ffmpeg /usr/local/bin/ffmpeg
STRATA_STUDIO_ARGS=
